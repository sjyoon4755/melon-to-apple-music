# Copy this file to ~/.melon-to-apple-music/.env
# (%USERPROFILE%\.melon-to-apple-music\.env on Windows).
#
# Matching uses the unauthenticated iTunes Search API. The values below are
# needed only for Apple Music account authorization and apply --execute.
APPLE_MUSIC_DEVELOPER_TOKEN=

# Instead of a ready token, configure all three values below. Keep the .p8 key
# in a private location. On macOS use a path like
# /Users/you/secure/AuthKey_XXXXXXXXXX.p8 instead.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=C:\\secure\\AuthKey_XXXXXXXXXX.p8

# Only playlist creation/addition needs a Music User Token.
# Prefer `melon-to-apple-music apple-auth`; this variable is a manual fallback.
APPLE_MUSIC_USER_TOKEN=

# Optional overrides. The write backend is intentionally CLI-only: use
# --backend web-player for each explicit opt-in.
APPLE_MUSIC_STOREFRONT=kr
